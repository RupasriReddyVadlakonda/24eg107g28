# Copy to .env for local development. Use unique secrets; never commit .env.
DB_URL=jdbc:mysql://localhost:3306/personal_data_vault?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=vault_app
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-base64-encoded-random-key-at-least-32-bytes
ENCRYPTION_KEY=replace-with-base64-encoded-random-32-byte-key
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SERVER_PORT=8082
JPA_DDL_AUTO=update
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=300
ALERT_UNAUTHORIZED_THRESHOLD=10
ALERT_WINDOW_SECONDS=300

